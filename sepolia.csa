body {
    font-family: 'Segoe UI', Arial, sans-serif;
    background-color: #0f172a;
    color: #f8fafc;
    text-align: center;
    padding: 40px 10px;
    margin: 0;
}

.container {
    background: #1e293b;
    max-width: 480px;
    width: 100%;
    display: inline-block;
    padding: 30px;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    box-sizing: border-box;
    text-align: left;
}

header {
    text-align: center;
    border-bottom: 1px solid #334155;
    padding-bottom: 15px;
    margin-bottom: 20px;
}

header h2 { margin: 0 0 10px 0; color: #38bdf8; }
#networkStatus { font-size: 13px; color: #94a3b8; margin: 8px 0 0 0; font-weight: bold; }

/* Sistema de Pestañas */
.tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}
.tab-btn {
    flex: 1;
    background: #334155;
    padding: 10px;
    border: none;
    color: #94a3b8;
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
}
.tab-btn.active {
    background: #38bdf8;
    color: #0f172a;
}

.tab-content { display: none; }
.tab-content.active { display: block; }

h3 { margin-top: 0; color: #f1f5f9; }
.subtitle { font-size: 13px; color: #94a3b8; margin-top: -8px; }

/* Bloques de Datos e Inputs */
.pool-info {
    font-weight: bold;
    padding: 10px;
    border-radius: 8px;
    margin-bottom: 15px;
    text-align: center;
}
.green-pool { background: rgba(34, 197, 94, 0.15); color: #4ade80; }
.blue-pool { background: rgba(56, 189, 248, 0.15); color: #38bdf8; }

input {
    width: 100%;
    padding: 12px;
    background: #0f172a;
    border: 1px solid #475569;
    color: #fff;
    font-size: 16px;
    border-radius: 8px;
    text-align: center;
    box-sizing: border-box;
    margin-bottom: 15px;
}

.calc-box { font-weight: bold; text-align: center; margin: 15px 0; line-height: 1.5; }

/* Botones de Acción */
.action-btn {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
    color: #fff;
    transition: opacity 0.2s;
}
.action-btn:hover { opacity: 0.9; }

#connectBtn { background: #6366f1; width: auto; padding: 8px 16px; border-radius: 6px; }
.buy-btn { background: #22c55e; }
.claim-btn { background: #38bdf8; color: #0f172a; }

/* Alertas de Precio Escalado */
.alert-mid { color: #fb923c; display: block; font-size: 13px; margin-top: 5px; font-weight: bold; }
.alert-high { color: #f87171; display: block; font-size: 13px; margin-top: 5px; font-weight: bold; animation: pulse 1.2s infinite; }
@keyframes pulse { 50% { opacity: 0.5; } }

.log-box { text-align: center; font-weight: bold; margin-top: 15px; font-size: 14px; color: #cbd5e1; }

/* Estilos de Administrador */
.admin-box {
    margin-top: 25px;
    background: rgba(251, 146, 60, 0.08);
    border: 2px dashed #fb923c;
    padding: 20px;
    border-radius: 10px;
    display: none;
}
.admin-box h3 { color: #fb923c; font-size: 16px; margin: 0 0 5px 0; }
.admin-box p { font-size: 12px; color: #cbd5e1; margin: 0 0 12px 0; }
.admin-btn { background: #fb923c; }
